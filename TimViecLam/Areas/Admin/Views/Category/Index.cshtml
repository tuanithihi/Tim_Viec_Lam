@model TimViecLam.Models.ViewModels.PagedResult<TimViecLam.Models.ViewModels.JobCategoryViewModel>
@{
    ViewData["Title"] = "Quản lý Ngành nghề";
    var search = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1 text-dark fw-bold">Quản lý Ngành nghề</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none">Bảng điều khiển</a></li>
                <li class="breadcrumb-item active" aria-current="page">Ngành nghề</li>
            </ol>
        </nav>
    </div>
    <button type="button" class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
        <i class="bi bi-plus-circle me-1"></i>Thêm ngành nghề mới
    </button>
</div>

<!-- Search & Filter Card -->
<div class="card card-base mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-12">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tên, slug, mô tả..." value="@search" />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-brand btn-sm">Tìm kiếm</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a href="/Admin/Category" class="btn btn-neutral btn-sm ms-1">Xóa tìm</a>
                }
            </div>
            <div class="col text-end text-muted small d-none d-md-block">
                Tổng cộng: <strong class="text-dark">@Model.TotalItems</strong> ngành nghề
            </div>
        </form>
    </div>
</div>

<!-- Category Table -->
<div class="card card-base">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th style="width: 60px;" class="text-center">Icon</th>
                        <th>Tên ngành nghề</th>
                        <th>Đường dẫn (Slug)</th>
                        <th class="text-center">Thứ tự</th>
                        <th class="text-center">Số việc làm</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end px-3" style="min-width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        int index = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var cat in Model.Items)
                        {
                            <tr>
                                <td class="text-center text-muted small">@(index++)</td>
                                <td class="text-center">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                                         style="width: 36px; height: 36px; background-color: var(--brand-primary-light); color: var(--brand-primary);">
                                        <i class="bi @(string.IsNullOrWhiteSpace(cat.Icon) ? "bi-briefcase" : cat.Icon)"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@cat.Name</div>
                                    @if (!string.IsNullOrEmpty(cat.Description))
                                    {
                                        <div class="text-muted text-xs text-truncate" style="max-width: 280px;" title="@cat.Description">
                                            @cat.Description
                                        </div>
                                    }
                                </td>
                                <td><code class="text-xs">@cat.Slug</code></td>
                                <td class="text-center small">@cat.SortOrder</td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">
                                        @cat.JobCount việc làm
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (cat.IsActive)
                                    {
                                        <span class="badge-status badge-status-active">
                                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-closed">
                                            <i class="bi bi-x-circle me-1"></i>Vô hiệu
                                        </span>
                                    }
                                </td>
                                <td class="text-end px-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-neutral" data-bs-toggle="modal" data-bs-target="#editModal-@cat.CategoryId" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" asp-action="ToggleActive" asp-route-id="@cat.CategoryId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-neutral text-warning" title="@(cat.IsActive ? "Tắt kích hoạt" : "Bật kích hoạt")">
                                                <i class="bi @(cat.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@cat.CategoryId" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa ngành nghề &quot;@cat.Name&quot;?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-neutral text-danger" title="Xóa ngành nghề">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                Không tìm thấy ngành nghề nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted">
                Trang @Model.CurrentPage / @Model.TotalPages (Hiển thị @Model.Items.Count trong @Model.TotalItems bản ghi)
            </div>
            <ul class="pagination custom-pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="/Admin/Category?page=@(Model.CurrentPage - 1)&search=@search">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/Admin/Category?page=@p&search=@search">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="/Admin/Category?page=@(Model.CurrentPage + 1)&search=@search">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Modal: Thêm ngành nghề mới -->
<div class="modal fade" id="createCategoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--radius-lg);">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-danger me-2"></i>Thêm ngành nghề mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tên ngành nghề <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Công nghệ thông tin" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Biểu tượng (Bootstrap Icons class)</label>
                        <input type="text" name="Icon" class="form-control" placeholder="bi-briefcase, bi-laptop, bi-graph-up..." value="bi-briefcase" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Thứ tự hiển thị</label>
                        <input type="number" name="SortOrder" class="form-control" value="0" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mô tả tóm tắt</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Mô tả tóm tắt các vị trí trong ngành nghề này..."></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="createIsActive">
                        <label class="form-check-label" for="createIsActive">Kích hoạt ngay khi tạo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-neutral btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-brand btn-sm">Lưu ngành nghề</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modals: Chỉnh sửa ngành nghề -->
@foreach (var cat in Model.Items)
{
    <div class="modal fade" id="editModal-@cat.CategoryId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: var(--radius-lg);">
                <form method="post" asp-action="Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CategoryId" value="@cat.CategoryId" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold"><i class="bi bi-pencil text-danger me-2"></i>Cập nhật ngành nghề</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Tên ngành nghề <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" value="@cat.Name" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Đường dẫn định danh (Slug)</label>
                            <input type="text" class="form-control bg-light" value="@cat.Slug" readonly disabled />
                            <div class="text-xs text-muted mt-1">Slug sẽ tự động cập nhật lại nếu bạn đổi tên.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Biểu tượng (Bootstrap Icons class)</label>
                            <input type="text" name="Icon" class="form-control" value="@cat.Icon" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Thứ tự hiển thị</label>
                            <input type="number" name="SortOrder" class="form-control" value="@cat.SortOrder" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mô tả tóm tắt</label>
                            <textarea name="Description" class="form-control" rows="3">@cat.Description</textarea>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(cat.IsActive ? "checked" : "") id="editIsActive-@cat.CategoryId">
                            <label class="form-check-label" for="editIsActive-@cat.CategoryId">Kích hoạt ngành nghề</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-neutral btn-sm" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-brand btn-sm">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

