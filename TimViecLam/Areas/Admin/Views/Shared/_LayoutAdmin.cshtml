@inject TimViecLam.Services.ICurrentUserService _currentUser
@{
    var currentPath = Context.Request.Path.Value ?? "/Admin";
    bool IsActive(string path) => currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    string displayName = _currentUser.Username ?? "SuperAdmin";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewData["Title"] ?? "Quản trị Hệ thống") - TimViecLam Admin</title>

    <!-- Vendor CSS: Bootstrap 5 + Bootstrap Icons -->
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" asp-append-version="true">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" crossorigin="anonymous">

    <!-- Design System CSS -->
    <link href="~/css/variables.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/base.css" rel="stylesheet" asp-append-version="true">

    <style>
        :root {
            --admin-sidebar-width: 260px;
            --admin-header-height: 64px;
        }
        body {
            background-color: var(--color-bg-page, #f8f9fa);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        .admin-header {
            height: var(--admin-header-height);
            background-color: #ffffff;
            border-bottom: 1px solid var(--border-color);
            position: sticky;
            top: 0;
            z-index: 1030;
        }
        .admin-wrapper {
            display: flex;
            flex: 1;
        }
        .admin-sidebar {
            width: var(--admin-sidebar-width);
            background-color: #ffffff;
            border-right: 1px solid var(--border-color);
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
            transition: all var(--transition-fast);
        }
        .admin-nav-item {
            padding: 10px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            color: var(--gray-700);
            text-decoration: none;
            font-size: var(--text-sm);
            font-weight: var(--font-medium);
            border-radius: var(--radius-md);
            margin: 2px 12px;
            transition: all var(--transition-fast);
        }
        .admin-nav-item:hover {
            background-color: var(--gray-100);
            color: var(--brand-primary);
        }
        .admin-nav-item.active {
            background-color: var(--brand-primary-light);
            color: var(--brand-primary);
            font-weight: var(--font-semibold);
        }
        .admin-content {
            flex: 1;
            padding: 24px;
            overflow-x: auto;
        }
        @@media (max-width: 991px) {
            .admin-sidebar {
                position: fixed;
                top: var(--admin-header-height);
                bottom: 0;
                left: -260px;
                z-index: 1025;
            }
            .admin-sidebar.show {
                left: 0;
                box-shadow: var(--shadow-drawer);
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ── Header ───────────────────────────────────────────── -->
    <header class="admin-header px-3 d-flex align-items-center justify-content-between">
        <div class="d-flex align-items-center gap-3">
            <button type="button" class="btn btn-neutral btn-sm d-lg-none" id="sidebarToggle" aria-label="Menu quản trị">
                <i class="bi bi-list fs-5"></i>
            </button>
            <a href="/Admin" class="d-flex align-items-center gap-2 text-decoration-none">
                <div class="brand-icon" style="width:32px; height:32px; background-color:var(--brand-primary); color:#ffffff; border-radius:var(--radius-md); display:flex; align-items:center; justify-content:center;">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <span class="fw-bold fs-5 text-dark">TimViecLam</span>
                <span class="badge ms-1" style="background-color: var(--brand-primary-light); color: var(--brand-primary); border: 1px solid var(--brand-primary-border);">
                    <i class="bi bi-shield-lock me-1"></i>SuperAdmin
                </span>
            </a>
        </div>

        <div class="d-flex align-items-center gap-3">
            <a href="/" target="_blank" class="btn btn-neutral btn-sm d-none d-sm-inline-flex" title="Xem trang người dùng">
                <i class="bi bi-box-arrow-up-right me-1"></i>Xem trang web
            </a>

            <div class="dropdown">
                <button class="btn btn-neutral btn-sm dropdown-toggle d-flex align-items-center gap-2" type="button" id="adminUserDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-person-circle fs-6 text-danger"></i>
                    <span class="d-none d-md-inline fw-semibold">@displayName</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="adminUserDropdown">
                    <li><h6 class="dropdown-header">Quản trị viên SuperAdmin</h6></li>
                    <li><a class="dropdown-item" href="/ho-so"><i class="bi bi-person me-2"></i>Hồ sơ cá nhân</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="px-2">
                            <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                            </button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <!-- ── Main Layout ──────────────────────────────────────── -->
    <div class="admin-wrapper">
        <!-- Sidebar Navigation -->
        <aside class="admin-sidebar" id="adminSidebar">
            <div class="py-3 flex-grow-1">
                <div class="px-3 pb-2 mb-2 text-uppercase text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    Tổng quan
                </div>
                <a href="/Admin" class="admin-nav-item @(currentPath == "/Admin" || currentPath == "/Admin/" ? "active" : "")">
                    <i class="bi bi-speedometer2"></i>Bảng điều khiển
                </a>

                <div class="px-3 pt-3 pb-2 mb-2 text-uppercase text-muted fw-bold" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                    Quản lý Danh mục (Sprint 2)
                </div>
                <a href="/Admin/Category" class="admin-nav-item @(IsActive("/Admin/Category") ? "active" : "")">
                    <i class="bi bi-grid-fill"></i>Ngành nghề
                </a>
                <a href="/Admin/JobType" class="admin-nav-item @(IsActive("/Admin/JobType") ? "active" : "")">
                    <i class="bi bi-clock-history"></i>Hình thức làm việc
                </a>
                <a href="/Admin/Skill" class="admin-nav-item @(IsActive("/Admin/Skill") ? "active" : "")">
                    <i class="bi bi-award-fill"></i>Kỹ năng chuyên môn
                </a>
                <a href="/Admin/Benefit" class="admin-nav-item @(IsActive("/Admin/Benefit") ? "active" : "")">
                    <i class="bi bi-gift-fill"></i>Chế độ phúc lợi
                </a>
                <a href="/Admin/Location" class="admin-nav-item @(IsActive("/Admin/Location") ? "active" : "")">
                    <i class="bi bi-geo-alt-fill"></i>Địa giới hành chính
                </a>
            </div>

            <div class="p-3 border-top text-muted small">
                <div>TimViecLam v2.0</div>
                <div class="text-xs text-muted">Chức năng 3 • Sprint 2</div>
            </div>
        </aside>

        <!-- Content Area -->
        <main class="admin-content">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border" role="alert">
                    <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <!-- Vendor Scripts -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var toggle = document.getElementById('sidebarToggle');
            var sidebar = document.getElementById('adminSidebar');
            if (toggle && sidebar) {
                toggle.addEventListener('click', function () {
                    sidebar.classList.toggle('show');
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
