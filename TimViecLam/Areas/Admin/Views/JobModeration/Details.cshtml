@model TimViecLam.Models.ViewModels.JobModerationDetailsViewModel
@{
    ViewData["Title"] = $"Duyệt tin: {Model.Title}";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid px-0">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-xs">
                    <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none text-muted">Bảng điều khiển</a></li>
                    <li class="breadcrumb-item"><a href="/admin/duyet-tin" class="text-decoration-none text-muted">Duyệt tin</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Xem Xét & Phê Duyệt Tin Tuyển Dụng</h1>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/duyet-tin" class="btn btn-neutral btn-sm px-3">
                <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
            </a>

            @if (Model.ApprovalStatus == "Pending")
            {
                <form method="post" action="/admin/duyet-tin/duyet/@Model.JobId" class="d-inline" onsubmit="return confirm('Xác nhận phê duyệt và xuất bản tin này?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success btn-sm px-3">
                        <i class="bi bi-check-lg me-1"></i>Phê duyệt tin
                    </button>
                </form>

                <button type="button" class="btn btn-danger btn-sm px-3" onclick="openRejectModal(@Model.JobId, '@Html.Raw(Html.Encode(Model.Title))')">
                    <i class="bi bi-x-lg me-1"></i>Từ chối tin
                </button>
            }

            @if (Model.ApprovalStatus == "Published")
            {
                <button type="button" class="btn btn-warning btn-sm px-3" onclick="openUnpublishModal(@Model.JobId, '@Html.Raw(Html.Encode(Model.Title))')">
                    <i class="bi bi-arrow-down-circle me-1"></i>Gỡ tin xuất bản
                </button>
            }
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Nội dung tin tuyển dụng -->
        <div class="col-12 col-lg-8">
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold text-dark">@Model.Title</h5>
                    <div>
                        @switch (Model.ApprovalStatus)
                        {
                            case "Published":
                                <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Đang xuất bản</span>
                                break;
                            case "Pending":
                                <span class="badge bg-warning text-dark fs-6"><i class="bi bi-clock-history me-1"></i>Chờ duyệt</span>
                                break;
                            case "Rejected":
                                <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Đã từ chối</span>
                                break;
                            case "Closed":
                                <span class="badge bg-dark fs-6"><i class="bi bi-lock me-1"></i>Đã gỡ / đóng</span>
                                break;
                            default:
                                <span class="badge bg-secondary fs-6">@Model.ApprovalStatus</span>
                                break;
                        }
                    </div>
                </div>
                <div class="card-body p-4">
                    @if (!string.IsNullOrEmpty(Model.RejectReason))
                    {
                        <div class="alert alert-danger mb-4">
                            <strong><i class="bi bi-exclamation-octagon me-1"></i>Lý do từ chối/gỡ tin:</strong>
                            <div class="mt-1">@Model.RejectReason</div>
                        </div>
                    }

                    <!-- Tóm tắt thông tin quan trọng -->
                    <div class="row g-3 mb-4 p-3 bg-light rounded border">
                        <div class="col-6 col-md-3">
                            <span class="text-xs text-muted d-block">Mức lương</span>
                            <span class="fw-bold text-danger">@Model.SalaryDisplay</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-xs text-muted d-block">Hình thức / Chế độ</span>
                            <span class="fw-semibold">@Model.JobTypeName (@Model.WorkMode)</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-xs text-muted d-block">Kinh nghiệm</span>
                            <span class="fw-semibold">@Model.ExperienceLevel</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-xs text-muted d-block">Hạn nộp hồ sơ</span>
                            <span class="fw-semibold">@Model.ExpiresAt.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-xs text-muted d-block">Ngành nghề</span>
                            <span>@Model.CategoryName</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-xs text-muted d-block">Trình độ học vấn</span>
                            <span>@Model.EducationLevel</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-xs text-muted d-block">Số lượng tuyển</span>
                            <span>@Model.Headcount người</span>
                        </div>
                        <div class="col-6 col-md-3">
                            <span class="text-xs text-muted d-block">Địa điểm làm việc</span>
                            <span>@(string.IsNullOrEmpty(Model.WorkplaceName) ? "Làm việc từ xa" : Model.WorkplaceName)</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.WorkplaceAddress))
                    {
                        <div class="mb-4 text-xs text-muted">
                            <i class="bi bi-geo-alt-fill text-primary me-1"></i>Địa chỉ chi tiết: <strong>@Model.WorkplaceAddress</strong>
                        </div>
                    }

                    <!-- Kỹ năng yêu cầu -->
                    @if (Model.Skills.Count > 0)
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-award me-1 text-primary"></i>Kỹ năng chuyên môn yêu cầu:</h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var sk in Model.Skills)
                                {
                                    <span class="badge bg-light text-dark border px-2 py-1">@sk</span>
                                }
                            </div>
                        </div>
                    }

                    <!-- Phúc lợi -->
                    @if (Model.Benefits.Count > 0)
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-2"><i class="bi bi-gift me-1 text-primary"></i>Chế độ đãi ngộ:</h6>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var bf in Model.Benefits)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">
                                        <i class="bi bi-check2 me-1"></i>@bf
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    <hr />

                    <!-- Mô tả công việc -->
                    <div class="mb-4">
                        <h6 class="fw-bold text-dark mb-3"><i class="bi bi-card-text me-1 text-primary"></i>Mô tả công việc:</h6>
                        <div class="job-description-content border rounded p-3 bg-white" style="line-height: 1.7;">
                            @Html.Raw(Model.Description)
                        </div>
                    </div>

                    <!-- Yêu cầu công việc -->
                    @if (!string.IsNullOrWhiteSpace(Model.Requirements))
                    {
                        <div class="mb-4">
                            <h6 class="fw-bold text-dark mb-3"><i class="bi bi-check2-square me-1 text-primary"></i>Yêu cầu ứng viên:</h6>
                            <div class="job-requirements-content border rounded p-3 bg-white" style="line-height: 1.7;">
                                @Html.Raw(Model.Requirements)
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Lịch sử Audit Log của tin này -->
            <div class="card border shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-clock-history me-2 text-primary"></i>Nhật ký kiểm toán của tin đăng (Audit Logs)</h6>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0 text-xs">
                        <thead class="table-light">
                            <tr>
                                <th>Thời gian</th>
                                <th>Hành động</th>
                                <th>Chi tiết / Lý do</th>
                                <th>Người thực hiện</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.AuditLogs.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-center py-3 text-muted">Chưa có lịch sử kiểm toán nào được ghi nhận.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var log in Model.AuditLogs)
                                {
                                    <tr>
                                        <td>@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                        <td><span class="badge bg-light text-dark border">@log.Action</span></td>
                                        <td>@log.Details</td>
                                        <td>@(log.UserId.HasValue ? $"User #{log.UserId}" : "Hệ thống")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Cột phải: Thông tin công ty & Thao tác kiểm duyệt -->
        <div class="col-12 col-lg-4">
            <!-- Thẻ công ty -->
            <div class="card border shadow-sm mb-4">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-building me-2 text-primary"></i>Doanh nghiệp đăng tuyển</h6>
                </div>
                <div class="card-body p-4 text-center">
                    @if (!string.IsNullOrEmpty(Model.CompanyLogo))
                    {
                        <img src="@Model.CompanyLogo" alt="@Model.CompanyName" class="rounded border p-2 mb-3" style="width: 90px; height: 90px; object-fit: contain;" />
                    }
                    else
                    {
                        <div class="rounded border bg-light d-inline-flex align-items-center justify-content-center text-muted mb-3" style="width: 90px; height: 90px;">
                            <i class="bi bi-building fs-1"></i>
                        </div>
                    }

                    <h6 class="fw-bold text-dark mb-1">
                        <a href="/Admin/Company/Details/@Model.CompanyId" class="text-decoration-none text-dark hover-primary">
                            @Model.CompanyName
                        </a>
                    </h6>

                    <div class="mb-3">
                        @switch (Model.CompanyStatus)
                        {
                            case "Approved":
                                <span class="badge bg-success"><i class="bi bi-shield-check me-1"></i>Đã phê duyệt</span>
                                break;
                            case "Pending":
                                <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>Chờ duyệt hồ sơ</span>
                                break;
                            case "Suspended":
                                <span class="badge bg-danger"><i class="bi bi-lock me-1"></i>Đang bị tạm khóa</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@Model.CompanyStatus</span>
                                break;
                        }
                    </div>

                    <div class="text-start text-xs text-muted border-top pt-3 d-flex flex-column gap-2">
                        @if (!string.IsNullOrEmpty(Model.CompanyWebsite))
                        {
                            <div><i class="bi bi-globe me-2 text-primary"></i><a href="@Model.CompanyWebsite" target="_blank">@Model.CompanyWebsite</a></div>
                        }
                        @if (!string.IsNullOrEmpty(Model.CompanyAddress))
                        {
                            <div><i class="bi bi-geo-alt me-2 text-primary"></i>@Model.CompanyAddress</div>
                        }
                    </div>
                </div>
            </div>

            <!-- Thao tác kiểm duyệt nhanh -->
            <div class="card border shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-shield-lock me-2 text-primary"></i>Thao tác của Quản trị viên</h6>
                </div>
                <div class="card-body p-3 d-flex flex-column gap-2">
                    @if (Model.ApprovalStatus == "Pending")
                    {
                        <form method="post" action="/admin/duyet-tin/duyet/@Model.JobId" onsubmit="return confirm('Xác nhận phê duyệt và xuất bản tin này?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100 py-2">
                                <i class="bi bi-check2-circle me-1"></i>Phê duyệt & Xuất bản tin
                            </button>
                        </form>

                        <button type="button" class="btn btn-outline-danger w-100 py-2" onclick="openRejectModal(@Model.JobId, '@Html.Raw(Html.Encode(Model.Title))')">
                            <i class="bi bi-x-circle me-1"></i>Từ chối phê duyệt
                        </button>
                    }
                    else if (Model.ApprovalStatus == "Published")
                    {
                        <button type="button" class="btn btn-outline-warning w-100 py-2" onclick="openUnpublishModal(@Model.JobId, '@Html.Raw(Html.Encode(Model.Title))')">
                            <i class="bi bi-arrow-down-circle me-1"></i>Gỡ tin xuất bản
                        </button>
                    }
                    else
                    {
                        <div class="alert alert-secondary text-xs mb-0">
                            Tin này hiện ở trạng thái <strong>@Model.ApprovalStatus</strong>. Không có thao tác kiểm duyệt khả dụng.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal Từ chối tin -->
<div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" id="rejectForm">
            @Html.AntiForgeryToken()
            <div class="modal-content">
                <div class="modal-header border-bottom py-3">
                    <h6 class="modal-title fw-bold text-danger" id="rejectModalLabel"><i class="bi bi-x-circle me-2"></i>Từ chối tin tuyển dụng</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-sm mb-2">Bạn đang từ chối duyệt tin: <strong id="rejectJobTitle"></strong></p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lý do từ chối (bắt buộc) <span class="text-danger">*</span></label>
                        <textarea name="reason" id="rejectReason" class="form-control" rows="3" placeholder="Nhập lý do chi tiết..." required minlength="5"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-neutral btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger btn-sm">Xác nhận Từ chối</button>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- Modal Gỡ tin -->
<div class="modal fade" id="unpublishModal" tabindex="-1" aria-labelledby="unpublishModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <form method="post" id="unpublishForm">
            @Html.AntiForgeryToken()
            <div class="modal-content">
                <div class="modal-header border-bottom py-3">
                    <h6 class="modal-title fw-bold text-warning" id="unpublishModalLabel"><i class="bi bi-arrow-down-circle me-2"></i>Gỡ tin tuyển dụng</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-sm mb-2">Bạn đang gỡ tin: <strong id="unpublishJobTitle"></strong></p>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Lý do gỡ tin (bắt buộc) <span class="text-danger">*</span></label>
                        <textarea name="reason" id="unpublishReason" class="form-control" rows="3" placeholder="Nhập lý do gỡ tin..." required minlength="5"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-top py-2">
                    <button type="button" class="btn btn-neutral btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-warning btn-sm">Xác nhận Gỡ tin</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openRejectModal(jobId, title) {
            document.getElementById('rejectJobTitle').textContent = title;
            document.getElementById('rejectForm').action = `/admin/duyet-tin/tu-choi/${jobId}`;
            document.getElementById('rejectReason').value = '';
            new bootstrap.Modal(document.getElementById('rejectModal')).show();
        }

        function openUnpublishModal(jobId, title) {
            document.getElementById('unpublishJobTitle').textContent = title;
            document.getElementById('unpublishForm').action = `/admin/duyet-tin/go-tin/${jobId}`;
            document.getElementById('unpublishReason').value = '';
            new bootstrap.Modal(document.getElementById('unpublishModal')).show();
        }
    </script>
}

