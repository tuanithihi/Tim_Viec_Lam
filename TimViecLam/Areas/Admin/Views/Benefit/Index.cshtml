@model TimViecLam.Models.ViewModels.PagedResult<TimViecLam.Models.ViewModels.BenefitViewModel>
@{
    ViewData["Title"] = "Quản lý Chế độ phúc lợi";
    var search = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1 text-dark fw-bold">Quản lý Chế độ phúc lợi</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none">Bảng điều khiển</a></li>
                <li class="breadcrumb-item active" aria-current="page">Phúc lợi</li>
            </ol>
        </nav>
    </div>
    <button type="button" class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#createBenefitModal">
        <i class="bi bi-plus-circle me-1"></i>Thêm phúc lợi mới
    </button>
</div>

<!-- Search & Filter Card -->
<div class="card card-base mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-12">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tên phúc lợi, slug..." value="@search" />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-brand btn-sm">Tìm kiếm</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a href="/Admin/Benefit" class="btn btn-neutral btn-sm ms-1">Xóa tìm</a>
                }
            </div>
            <div class="col text-end text-muted small d-none d-md-block">
                Tổng cộng: <strong class="text-dark">@Model.TotalItems</strong> phúc lợi
            </div>
        </form>
    </div>
</div>

<!-- Benefit Table -->
<div class="card card-base">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th style="width: 60px;" class="text-center">Icon</th>
                        <th>Tên phúc lợi</th>
                        <th>Đường dẫn (Slug)</th>
                        <th>Mô tả</th>
                        <th class="text-center">Số tin tuyển dụng</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end px-3" style="min-width: 140px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        int index = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center text-muted small">@(index++)</td>
                                <td class="text-center">
                                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center"
                                         style="width: 36px; height: 36px; background-color: var(--brand-primary-light); color: var(--brand-primary);">
                                        <i class="bi @(string.IsNullOrWhiteSpace(item.Icon) ? "bi-gift" : item.Icon)"></i>
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-semibold text-dark">@item.Name</div>
                                </td>
                                <td><code class="text-xs">@item.Slug</code></td>
                                <td>
                                    <div class="text-muted text-xs text-truncate" style="max-width: 300px;" title="@item.Description">
                                        @(string.IsNullOrEmpty(item.Description) ? "—" : item.Description)
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@item.JobCount việc làm</span>
                                </td>
                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-status badge-status-active">
                                            <i class="bi bi-check-circle me-1"></i>Hoạt động
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-status-closed">
                                            <i class="bi bi-x-circle me-1"></i>Vô hiệu
                                        </span>
                                    }
                                </td>
                                <td class="text-end px-3">
                                    <div class="btn-group btn-group-sm">
                                        <button type="button" class="btn btn-neutral" data-bs-toggle="modal" data-bs-target="#editModal-@item.BenefitId" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <form method="post" asp-action="ToggleActive" asp-route-id="@item.BenefitId" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-neutral text-warning" title="@(item.IsActive ? "Tắt kích hoạt" : "Bật kích hoạt")">
                                                <i class="bi @(item.IsActive ? "bi-eye-slash" : "bi-eye")"></i>
                                            </button>
                                        </form>
                                        <form method="post" asp-action="Delete" asp-route-id="@item.BenefitId" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc chắn muốn xóa phúc lợi &quot;@item.Name&quot;?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-neutral text-danger" title="Xóa phúc lợi">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                Không tìm thấy phúc lợi nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted">
                Trang @Model.CurrentPage / @Model.TotalPages (Hiển thị @Model.Items.Count trong @Model.TotalItems bản ghi)
            </div>
            <ul class="pagination custom-pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="/Admin/Benefit?page=@(Model.CurrentPage - 1)&search=@search">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/Admin/Benefit?page=@p&search=@search">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="/Admin/Benefit?page=@(Model.CurrentPage + 1)&search=@search">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>

<!-- Modal Thêm phúc lợi mới -->
<div class="modal fade" id="createBenefitModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius: var(--radius-lg);">
            <form method="post" asp-action="Create">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title fw-bold"><i class="bi bi-plus-circle text-danger me-2"></i>Thêm phúc lợi mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Tên phúc lợi <span class="text-danger">*</span></label>
                        <input type="text" name="Name" class="form-control" placeholder="Ví dụ: Thưởng tháng 13, Bảo hiểm PVI..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Biểu tượng (Bootstrap Icons class)</label>
                        <input type="text" name="Icon" class="form-control" placeholder="bi-gift, bi-shield-plus, bi-airplane..." value="bi-gift" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mô tả tóm tắt</label>
                        <textarea name="Description" class="form-control" rows="3" placeholder="Mô tả chế độ phúc lợi..."></textarea>
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" checked id="createBenefitActive">
                        <label class="form-check-label" for="createBenefitActive">Kích hoạt ngay khi tạo</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-neutral btn-sm" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-brand btn-sm">Lưu phúc lợi</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modals Chỉnh sửa phúc lợi -->
@foreach (var item in Model.Items)
{
    <div class="modal fade" id="editModal-@item.BenefitId" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: var(--radius-lg);">
                <form method="post" asp-action="Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BenefitId" value="@item.BenefitId" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold"><i class="bi bi-pencil text-danger me-2"></i>Cập nhật phúc lợi</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Tên phúc lợi <span class="text-danger">*</span></label>
                            <input type="text" name="Name" class="form-control" value="@item.Name" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Đường dẫn định danh (Slug)</label>
                            <input type="text" class="form-control bg-light" value="@item.Slug" readonly disabled />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Biểu tượng (Bootstrap Icons class)</label>
                            <input type="text" name="Icon" class="form-control" value="@item.Icon" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mô tả tóm tắt</label>
                            <textarea name="Description" class="form-control" rows="3">@item.Description</textarea>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" @(item.IsActive ? "checked" : "") id="editBenefitActive-@item.BenefitId">
                            <label class="form-check-label" for="editBenefitActive-@item.BenefitId">Kích hoạt phúc lợi</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-neutral btn-sm" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-brand btn-sm">Cập nhật</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

