@model TimViecLam.Models.ViewModels.PagedResult<TimViecLam.Models.ViewModels.CompanyAdminViewModel>
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "Kiểm duyệt & Quản lý Công ty";
    string? search = ViewBag.Search as string;
    string? status = ViewBag.Status as string;
}

<div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1 text-dark fw-bold">Kiểm duyệt & Quản lý Doanh nghiệp</h1>
        <p class="text-muted small mb-0">Xem xét hồ sơ pháp lý, phê duyệt hoặc từ chối các công ty nhà tuyển dụng đăng ký trên hệ thống.</p>
    </div>
</div>

<!-- Bộ lọc trạng thái và tìm kiếm -->
<div class="card border shadow-sm mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-12 col-md-3">
                <select name="status" class="form-select form-select-sm" onchange="this.form.submit()">
                    <option value="" selected="@(string.IsNullOrEmpty(status))">-- Tất cả trạng thái --</option>
                    <option value="Pending" selected="@(status == "Pending")">⏳ Chờ duyệt (Pending)</option>
                    <option value="Approved" selected="@(status == "Approved")">✅ Đã duyệt (Approved)</option>
                    <option value="Rejected" selected="@(status == "Rejected")">❌ Bị từ chối (Rejected)</option>
                    <option value="Suspended" selected="@(status == "Suspended")">🔒 Bị tạm khóa (Suspended)</option>
                </select>
            </div>
            <div class="col-12 col-md-6">
                <div class="input-group input-group-sm">
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tên công ty, mã số thuế, email, tài khoản..." value="@search" />
                    <button class="btn btn-neutral" type="submit"><i class="bi bi-search me-1"></i>Tìm kiếm</button>
                    @if (!string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(status))
                    {
                        <a href="/Admin/Company" class="btn btn-outline-secondary" title="Xóa bộ lọc"><i class="bi bi-x-lg"></i></a>
                    }
                </div>
            </div>
            <div class="col-12 col-md-3 text-md-end text-muted small">
                Tổng cộng: <strong class="text-dark">@Model.TotalItems</strong> công ty
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách công ty -->
<div class="card border shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light text-muted small">
                <tr>
                    <th style="width: 50px;">#ID</th>
                    <th>Công ty</th>
                    <th>Người đại diện</th>
                    <th>Mã số thuế</th>
                    <th>Quy mô</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th class="text-end" style="min-width: 180px;">Hành động</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items == null || !Model.Items.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-building-slash fs-1 d-block mb-2 text-secondary"></i>
                            Không tìm thấy công ty nào phù hợp với bộ lọc hiện tại.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td class="text-muted fw-semibold">#@c.CompanyId</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(c.Logo))
                                    {
                                        <img src="@c.Logo" alt="@c.Name" class="rounded border" style="width: 40px; height: 40px; object-fit: contain; background: #fff;" />
                                    }
                                    else
                                    {
                                        <div class="rounded border d-flex align-items-center justify-content-center bg-light text-muted" style="width: 40px; height: 40px;">
                                            <i class="bi bi-building"></i>
                                        </div>
                                    }
                                    <div>
                                        <a href="/Admin/Company/Details/@c.CompanyId" class="fw-semibold text-dark text-decoration-none hover-primary">
                                            @c.Name
                                        </a>
                                        @if (!string.IsNullOrEmpty(c.Website))
                                        {
                                            <div class="text-xs text-muted">
                                                <a href="@c.Website" target="_blank" class="text-muted text-decoration-none">
                                                    <i class="bi bi-link-45deg"></i>@c.Website
                                                </a>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small fw-semibold">@c.Username</div>
                                <div class="text-xs text-muted">@c.UserEmail</div>
                            </td>
                            <td>
                                @(string.IsNullOrEmpty(c.TaxCode) ? "-" : c.TaxCode)
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@c.CompanySize</span>
                            </td>
                            <td>
                                @if (c.Status == "Approved")
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">
                                        <i class="bi bi-check-circle-fill me-1"></i>Đã duyệt
                                    </span>
                                }
                                else if (c.Status == "Pending")
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle">
                                        <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                                    </span>
                                }
                                else if (c.Status == "Rejected")
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" title="@c.RejectReason">
                                        <i class="bi bi-x-circle-fill me-1"></i>Bị từ chối
                                    </span>
                                }
                                else if (c.Status == "Suspended")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle" title="@c.RejectReason">
                                        <i class="bi bi-lock-fill me-1"></i>Tạm khóa
                                    </span>
                                }
                            </td>
                            <td class="text-xs text-muted">
                                @c.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="/Admin/Company/Details/@c.CompanyId" class="btn btn-outline-secondary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @if (c.Status == "Pending" || c.Status == "Rejected")
                                    {
                                        <form asp-action="Approve" asp-route-id="@c.CompanyId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-success" title="Phê duyệt công ty">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    }

                                    @if (c.Status == "Pending")
                                    {
                                        <button type="button" class="btn btn-outline-danger" title="Từ chối công ty"
                                                data-bs-toggle="modal" data-bs-target="#rejectModal-@c.CompanyId">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }

                                    @if (c.Status == "Approved")
                                    {
                                        <button type="button" class="btn btn-outline-warning" title="Tạm khóa công ty"
                                                data-bs-toggle="modal" data-bs-target="#suspendModal-@c.CompanyId">
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    }

                                    @if (c.Status == "Suspended")
                                    {
                                        <form asp-action="Unsuspend" asp-route-id="@c.CompanyId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-primary" title="Mở khóa công ty">
                                                <i class="bi bi-unlock"></i>
                                            </button>
                                        </form>
                                    }
                                </div>

                                <!-- Modal Từ chối -->
                                <div class="modal fade text-start" id="rejectModal-@c.CompanyId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Reject" asp-route-id="@c.CompanyId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fs-6 fw-bold text-danger">Từ chối phê duyệt công ty</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted mb-2">Bạn đang từ chối phê duyệt cho công ty: <strong>@c.Name</strong>.</p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Lý do từ chối <span class="text-danger">*</span></label>
                                                        <textarea name="reason" class="form-control" rows="3" required placeholder="Nhập lý do cụ thể (sai mã số thuế, thiếu thông tin pháp lý...)"></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                                                    <button type="submit" class="btn btn-danger btn-sm">Xác nhận Từ chối</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>

                                <!-- Modal Tạm khóa -->
                                <div class="modal fade text-start" id="suspendModal-@c.CompanyId" tabindex="-1" aria-hidden="true">
                                    <div class="modal-dialog">
                                        <div class="modal-content">
                                            <form asp-action="Suspend" asp-route-id="@c.CompanyId" method="post">
                                                @Html.AntiForgeryToken()
                                                <div class="modal-header">
                                                    <h5 class="modal-title fs-6 fw-bold text-warning-emphasis">Tạm khóa công ty</h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="small text-muted mb-2">Bạn đang tạm dừng hoạt động của công ty: <strong>@c.Name</strong>. Tài khoản sẽ bị chặn đăng tin.</p>
                                                    <div class="mb-3">
                                                        <label class="form-label small fw-semibold">Lý do tạm khóa <span class="text-danger">*</span></label>
                                                        <textarea name="reason" class="form-control" rows="3" required placeholder="Nhập lý do tạm khóa (vi phạm quy chế tuyển dụng, khiếu nại lừa đảo...)"></textarea>
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                                                    <button type="submit" class="btn btn-warning btn-sm">Xác nhận Tạm khóa</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2 px-3">
            <div class="small text-muted">
                Trang @Model.CurrentPage / @Model.TotalPages (tổng @Model.TotalItems bản ghi)
            </div>
            <nav aria-label="Phân trang công ty">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                        <a class="page-link" href="/Admin/Company?page=@(Model.CurrentPage - 1)&search=@search&status=@status">Trước</a>
                    </li>
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" href="/Admin/Company?page=@i&search=@search&status=@status">@i</a>
                        </li>
                    }
                    <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                        <a class="page-link" href="/Admin/Company?page=@(Model.CurrentPage + 1)&search=@search&status=@status">Sau</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

