@model TimViecLam.Models.ViewModels.PagedResult<TimViecLam.Models.ViewModels.LocationProvinceViewModel>
@{
    ViewData["Title"] = "Địa giới hành chính";
    var search = ViewBag.Search as string ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h1 class="h3 mb-1 text-dark fw-bold">Địa giới hành chính</h1>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0 small">
                <li class="breadcrumb-item"><a href="/Admin" class="text-decoration-none">Bảng điều khiển</a></li>
                <li class="breadcrumb-item active" aria-current="page">Địa giới hành chính</li>
            </ol>
        </nav>
    </div>
</div>

<!-- Search & Filter Card -->
<div class="card card-base mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6 col-12">
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" class="form-control" placeholder="Tìm theo tên tỉnh/thành, mã, đường dẫn tĩnh..." value="@search" />
                </div>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-brand btn-sm">Tìm kiếm</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a href="/Admin/Location" class="btn btn-neutral btn-sm ms-1">Xóa tìm</a>
                }
            </div>
            <div class="col text-end text-muted small d-none d-md-block">
                Tổng cộng: <strong class="text-dark">@Model.TotalItems</strong> Tỉnh/Thành phố
            </div>
        </form>
    </div>
</div>

<!-- Location Table -->
<div class="card card-base">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50px;" class="text-center">#</th>
                        <th style="width: 100px;">Mã tỉnh</th>
                        <th>Tên Tỉnh/Thành phố</th>
                        <th>Tên đầy đủ</th>
                        <th>Đường dẫn tĩnh</th>
                        <th class="text-center">Số quận/huyện</th>
                        <th class="text-center">Địa điểm làm việc</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        int index = (Model.CurrentPage - 1) * Model.PageSize + 1;
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-center text-muted small">@(index++)</td>
                                <td><span class="badge bg-secondary-subtle text-secondary border">@item.Code</span></td>
                                <td class="fw-semibold text-dark">@item.Name</td>
                                <td class="text-muted small">@item.FullName</td>
                                <td><code class="text-xs">@item.Slug</code></td>
                                <td class="text-center">
                                    <span class="badge bg-light text-dark border">@item.DistrictCount quận/huyện</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-info-subtle text-info border">@item.WorkplaceCount địa điểm</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                                Không tìm thấy tỉnh/thành phố nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer bg-white border-top p-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div class="small text-muted">
                Trang @Model.CurrentPage / @Model.TotalPages (Hiển thị @Model.Items.Count trong @Model.TotalItems bản ghi)
            </div>
            <ul class="pagination custom-pagination pagination-sm mb-0">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="/Admin/Location?page=@(Model.CurrentPage - 1)&search=@search">
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="/Admin/Location?page=@p&search=@search">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="/Admin/Location?page=@(Model.CurrentPage + 1)&search=@search">
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </div>
    }
</div>

