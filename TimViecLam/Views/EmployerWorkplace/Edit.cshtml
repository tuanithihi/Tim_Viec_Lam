@model TimViecLam.Models.ViewModels.WorkplaceInputModel
@{
    ViewData["Title"] = $"Chỉnh sửa địa điểm - {Model.Name}";
    var provinces = ViewBag.Provinces as List<TimViecLam.Models.ViewModels.GeoItemDto> ?? new();
}

@section Styles {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />
    <style>
        #workplaceMap {
            height: 380px;
            width: 100%;
            border-radius: var(--radius-md);
            border: 1px solid var(--border-color);
            position: relative;
            z-index: 1;
        }
        #workplaceMap img,
        .leaflet-pane img,
        .leaflet-tile {
            max-width: none !important;
            max-height: none !important;
            display: inline !important;
        }
    </style>
}

<div class="container-xl py-4">
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 text-xs">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                <li class="breadcrumb-item"><a href="/nha-tuyen-dung/dia-diem" class="text-decoration-none text-muted">Địa điểm làm việc</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa #@Model.WorkplaceId</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold text-dark mb-0">Chỉnh sửa Địa điểm / Chi nhánh</h1>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.WorkplaceId" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="WorkplaceId" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger text-sm mb-3"></div>

        <div class="row g-4">
            <!-- Cột trái: Thông tin địa chỉ & Phân cấp hành chính -->
            <div class="col-12 col-lg-6">
                <div class="card border shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom">
                        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-geo-alt me-2 text-primary"></i>Thông tin địa chỉ</h6>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label small fw-semibold">Tên địa điểm / Chi nhánh <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger text-xs"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-12 col-md-4">
                                <label asp-for="ProvinceId" class="form-label small fw-semibold">Tỉnh / Thành phố <span class="text-danger">*</span></label>
                                <select asp-for="ProvinceId" id="selectProvince" class="form-select">
                                    <option value="">-- Chọn Tỉnh/Thành --</option>
                                    @foreach (var p in provinces)
                                    {
                                        <option value="@p.Id" selected="@(p.Id == Model.ProvinceId)">@p.Name</option>
                                    }
                                </select>
                                <span asp-validation-for="ProvinceId" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="DistrictId" class="form-label small fw-semibold">Quận / Huyện <span class="text-danger">*</span></label>
                                <select asp-for="DistrictId" id="selectDistrict" class="form-select" data-initial-district="@Model.DistrictId">
                                    <option value="">-- Đang tải... --</option>
                                </select>
                                <span asp-validation-for="DistrictId" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12 col-md-4">
                                <label asp-for="WardId" class="form-label small fw-semibold">Phường / Xã</label>
                                <select asp-for="WardId" id="selectWard" class="form-select" data-initial-ward="@(Model.WardId ?? 0)">
                                    <option value="">-- Chọn Phường/Xã --</option>
                                </select>
                                <span asp-validation-for="WardId" class="text-danger text-xs"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Address" class="form-label small fw-semibold">Địa chỉ chi tiết <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <input asp-for="Address" id="inputAddress" class="form-control" />
                                <button type="button" id="btnGeocode" class="btn btn-neutral" title="Tự động tìm tọa độ trên bản đồ">
                                    <i class="bi bi-search-heart me-1 text-primary"></i>Tìm tọa độ
                                </button>
                            </div>
                            <span asp-validation-for="Address" class="text-danger text-xs"></span>
                            <div id="geocodeStatus" class="text-xs text-muted mt-1"></div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input asp-for="IsHeadOffice" class="form-check-input" type="checkbox" id="checkHeadOffice" />
                            <label class="form-check-label small fw-semibold" for="checkHeadOffice">
                                Đặt làm Trụ sở chính của công ty
                            </label>
                            <div class="text-xs text-muted">Nếu bật, các địa điểm khác của công ty sẽ tự động chuyển thành chi nhánh.</div>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a href="/nha-tuyen-dung/dia-diem" class="btn btn-neutral btn-sm">
                                <i class="bi bi-arrow-left me-1"></i>Hủy
                            </a>
                            <button type="submit" class="btn btn-brand px-4">
                                <i class="bi bi-save me-1"></i>Lưu thay đổi
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Cột phải: Bản đồ tương tác Leaflet & Tọa độ -->
            <div class="col-12 col-lg-6">
                <div class="card border shadow-sm">
                    <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                        <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-map me-2 text-primary"></i>Bản đồ vị trí (Lãnh thổ Việt Nam)</h6>
                        <span class="text-xs text-muted">Bấm hoặc kéo ghim để cập nhật</span>
                    </div>
                    <div class="card-body p-3">
                        <div id="workplaceMap"></div>

                        <div class="row g-2 mt-3">
                            <div class="col-6">
                                <label asp-for="Latitude" class="form-label text-xs fw-semibold">Vĩ độ (Latitude: 8.0 - 24.0)</label>
                                <input asp-for="Latitude" id="inputLat" class="form-control form-control-sm" type="number" step="any" />
                                <span asp-validation-for="Latitude" class="text-danger text-xs"></span>
                            </div>
                            <div class="col-6">
                                <label asp-for="Longitude" class="form-label text-xs fw-semibold">Kinh độ (Longitude: 102.0 - 110.0)</label>
                                <input asp-for="Longitude" id="inputLng" class="form-control form-control-sm" type="number" step="any" />
                                <span asp-validation-for="Longitude" class="text-danger text-xs"></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', async function () {
            const selectProvince = document.getElementById('selectProvince');
            const selectDistrict = document.getElementById('selectDistrict');
            const selectWard = document.getElementById('selectWard');
            const inputAddress = document.getElementById('inputAddress');
            const inputLat = document.getElementById('inputLat');
            const inputLng = document.getElementById('inputLng');
            const btnGeocode = document.getElementById('btnGeocode');
            const geocodeStatus = document.getElementById('geocodeStatus');

            const initialDistrictId = selectDistrict.dataset.initialDistrict;
            const initialWardId = selectWard.dataset.initialWard;

            // ── Khởi tạo Icon chuẩn cho Leaflet ─────────────────────────
            delete L.Icon.Default.prototype._getIconUrl;
            L.Icon.Default.mergeOptions({
                iconRetinaUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon-2x.png',
                iconUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-icon.png',
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/images/marker-shadow.png'
            });

            // ── Khởi tạo Leaflet Map ────────────────────────────────────
            const initialLat = parseFloat(inputLat.value) || 21.0285;
            const initialLng = parseFloat(inputLng.value) || 105.8542;

            const map = L.map('workplaceMap').setView([initialLat, initialLng], 15);

            // Sử dụng tile layer CartoDB Voyager tốc độ cao, không lỗi CORS/Referrer
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                maxZoom: 19,
                subdomains: 'abcd',
                attribution: '&copy; OpenStreetMap contributors &copy; CARTO'
            }).addTo(map);

            setTimeout(function () {
                map.invalidateSize();
            }, 300);

            let marker = L.marker([initialLat, initialLng], { draggable: true }).addTo(map);

            function updateInputs(lat, lng) {
                inputLat.value = lat.toFixed(6);
                inputLng.value = lng.toFixed(6);
            }

            marker.on('dragend', function (e) {
                const pos = e.target.getLatLng();
                updateInputs(pos.lat, pos.lng);
            });

            map.on('click', function (e) {
                marker.setLatLng(e.latlng);
                updateInputs(e.latlng.lat, e.latlng.lng);
            });

            // ── Nạp danh sách Quận/Huyện ban đầu ─────────────────────────
            async function loadDistricts(provId, selectedDistId) {
                if (!provId) {
                    selectDistrict.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                    return;
                }
                try {
                    const res = await fetch(`/api/geo/districts?provinceId=${provId}`);
                    const districts = await res.json();
                    selectDistrict.innerHTML = '<option value="">-- Chọn Quận/Huyện --</option>';
                    districts.forEach(d => {
                        const sel = (d.id == selectedDistId) ? 'selected' : '';
                        selectDistrict.innerHTML += `<option value="${d.id}" ${sel}>${d.name}</option>`;
                    });
                } catch (err) {
                    selectDistrict.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
                }
            }

            async function loadWards(distId, selectedWardId) {
                if (!distId) {
                    selectWard.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                    return;
                }
                try {
                    const res = await fetch(`/api/geo/wards?districtId=${distId}`);
                    const wards = await res.json();
                    selectWard.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                    wards.forEach(w => {
                        const sel = (w.id == selectedWardId) ? 'selected' : '';
                        selectWard.innerHTML += `<option value="${w.id}" ${sel}>${w.name}</option>`;
                    });
                } catch (err) {
                    selectWard.innerHTML = '<option value="">-- Lỗi tải dữ liệu --</option>';
                }
            }

            // Nạp ban đầu
            if (selectProvince.value) {
                await loadDistricts(selectProvince.value, initialDistrictId);
                if (initialDistrictId) {
                    await loadWards(initialDistrictId, initialWardId);
                }
            }

            // Sự kiện thay đổi
            selectProvince.addEventListener('change', async function () {
                selectWard.innerHTML = '<option value="">-- Chọn Phường/Xã --</option>';
                await loadDistricts(this.value, null);
            });

            selectDistrict.addEventListener('change', async function () {
                await loadWards(this.value, null);
            });

            // ── Tìm tọa độ từ địa chỉ (Gọi API Geocode proxy Nominatim) ──
            btnGeocode.addEventListener('click', async function () {
                const addressVal = inputAddress.value.trim();
                const provText = selectProvince.options[selectProvince.selectedIndex]?.text || '';
                const distText = selectDistrict.options[selectDistrict.selectedIndex]?.text || '';

                const fullQuery = [addressVal, distText, provText]
                    .filter(s => s && !s.startsWith('--'))
                    .join(', ');

                if (!fullQuery) {
                    geocodeStatus.innerHTML = '<span class="text-danger">Vui lòng nhập địa chỉ trước khi tìm.</span>';
                    return;
                }

                geocodeStatus.innerHTML = '<span class="text-primary"><i class="bi bi-hourglass-split me-1"></i>Đang tìm vị trí trên bản đồ...</span>';

                try {
                    const response = await fetch(`/api/geo/geocode?q=${encodeURIComponent(fullQuery)}`);
                    if (response.status === 401 || response.status === 302) {
                        geocodeStatus.innerHTML = '<span class="text-danger">Vui lòng đăng nhập để sử dụng tính năng này.</span>';
                        return;
                    }
                    if (response.status === 429) {
                        geocodeStatus.innerHTML = '<span class="text-danger">Bạn đã tìm kiếm quá nhanh. Vui lòng thử lại sau vài giây.</span>';
                        return;
                    }

                    const data = await response.json();
                    if (Array.isArray(data) && data.length > 0) {
                        const first = data[0];
                        marker.setLatLng([first.latitude, first.longitude]);
                        map.setView([first.latitude, first.longitude], 16);
                        updateInputs(first.latitude, first.longitude);
                        geocodeStatus.innerHTML = `<span class="text-success"><i class="bi bi-check-circle me-1"></i>Đã tìm thấy: ${first.displayName.substring(0, 80)}...</span>`;
                    } else {
                        geocodeStatus.innerHTML = '<span class="text-warning-emphasis">Không tìm thấy tọa độ khớp. Vui lòng bấm trực tiếp trên bản đồ để ghim vị trí.</span>';
                    }
                } catch (err) {
                    geocodeStatus.innerHTML = '<span class="text-danger">Không thể kết nối đến máy chủ bản đồ.</span>';
                }
            });
        });
    </script>
}

