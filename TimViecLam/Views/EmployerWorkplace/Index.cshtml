@model TimViecLam.Models.ViewModels.PagedResult<TimViecLam.Models.ViewModels.WorkplaceViewModel>
@{
    ViewData["Title"] = "Địa điểm làm việc & Chi nhánh";
    string? search = ViewBag.Search as string;
}

<div class="container-xl py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-xs">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/nha-tuyen-dung/ho-so" class="text-decoration-none text-muted">Nhà tuyển dụng</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Địa điểm làm việc</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Địa điểm làm việc & Chi nhánh</h1>
        </div>
        <div>
            <a href="/nha-tuyen-dung/dia-diem/them" class="btn btn-brand btn-sm">
                <i class="bi bi-plus-lg me-1"></i>Thêm địa điểm mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 text-danger"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Tìm kiếm -->
    <div class="card border shadow-sm mb-4">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-12 col-md-6">
                    <div class="input-group input-group-sm">
                        <input type="text" name="search" class="form-control" placeholder="Tìm theo tên địa điểm, địa chỉ chi tiết, tỉnh, quận..." value="@search" />
                        <button class="btn btn-neutral" type="submit"><i class="bi bi-search me-1"></i>Tìm</button>
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <a href="/nha-tuyen-dung/dia-diem" class="btn btn-outline-secondary" title="Xóa tìm kiếm"><i class="bi bi-x-lg"></i></a>
                        }
                    </div>
                </div>
                <div class="col-12 col-md-6 text-md-end text-muted small">
                    Tổng số: <strong class="text-dark">@Model.TotalItems</strong> địa điểm
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách địa điểm -->
    <div class="card border shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th style="width: 50px;">#ID</th>
                        <th>Tên địa điểm / Chi nhánh</th>
                        <th>Địa chỉ cụ thể</th>
                        <th>Khu vực hành chính</th>
                        <th>Tọa độ bản đồ</th>
                        <th>Trụ sở</th>
                        <th class="text-end" style="min-width: 120px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items == null || !Model.Items.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <i class="bi bi-geo-alt-slash fs-1 d-block mb-2 text-secondary"></i>
                                Bạn chưa có địa điểm làm việc nào hoặc không khớp với tìm kiếm.
                                <div class="mt-2">
                                    <a href="/nha-tuyen-dung/dia-diem/them" class="btn btn-brand btn-sm">
                                        <i class="bi bi-plus-lg me-1"></i>Thêm địa điểm đầu tiên
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="text-muted fw-semibold">#@item.WorkplaceId</td>
                                <td>
                                    <span class="fw-semibold text-dark">@item.Name</span>
                                    @if (item.JobCount > 0)
                                    {
                                        <span class="badge bg-light text-muted border ms-1" title="Số tin tuyển dụng tại địa điểm này">
                                            @item.JobCount việc làm
                                        </span>
                                    }
                                </td>
                                <td class="small">@item.Address</td>
                                <td class="small">
                                    <div>@item.DistrictName, @item.ProvinceName</div>
                                    @if (!string.IsNullOrEmpty(item.WardName))
                                    {
                                        <div class="text-xs text-muted">Phường/Xã: @item.WardName</div>
                                    }
                                </td>
                                <td>
                                    @if (item.Latitude.HasValue && item.Longitude.HasValue)
                                    {
                                        <a href="https://www.google.com/maps?q=@item.Latitude,@item.Longitude" target="_blank"
                                           class="badge bg-light text-primary border text-decoration-none" title="Xem trên bản đồ">
                                            <i class="bi bi-geo-alt-fill me-1"></i>@item.Latitude.Value.ToString("F4"), @item.Longitude.Value.ToString("F4")
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-muted">Chưa ghim</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsHeadOffice)
                                    {
                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                            <i class="bi bi-star-fill me-1"></i>Trụ sở chính
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-xs text-muted">Chi nhánh</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/nha-tuyen-dung/dia-diem/sua/@item.WorkplaceId" class="btn btn-outline-secondary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-outline-danger" title="Xóa địa điểm"
                                                data-bs-toggle="modal" data-bs-target="#deleteModal-@item.WorkplaceId">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    <!-- Modal Xóa -->
                                    <div class="modal fade text-start" id="deleteModal-@item.WorkplaceId" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog">
                                            <div class="modal-content">
                                                <form asp-action="Delete" asp-route-id="@item.WorkplaceId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <div class="modal-header">
                                                        <h5 class="modal-title fs-6 fw-bold text-danger">Xác nhận xóa địa điểm</h5>
                                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        Bạn có chắc chắn muốn xóa địa điểm: <strong>@item.Name</strong>?
                                                        @if (item.JobCount > 0)
                                                        {
                                                            <div class="alert alert-warning text-xs mt-2 mb-0">
                                                                <i class="bi bi-exclamation-triangle me-1"></i>Địa điểm này hiện đang có @item.JobCount tin tuyển dụng liên kết và không thể xóa.
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                                                        <button type="submit" class="btn btn-danger btn-sm" @(item.JobCount > 0 ? "disabled" : "")>
                                                            Xác nhận Xóa
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top d-flex justify-content-between align-items-center py-2 px-3">
                <div class="small text-muted">
                    Trang @Model.CurrentPage / @Model.TotalPages
                </div>
                <nav aria-label="Phân trang địa điểm">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                            <a class="page-link" href="/nha-tuyen-dung/dia-diem?page=@(Model.CurrentPage - 1)&search=@search">Trước</a>
                        </li>
                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="/nha-tuyen-dung/dia-diem?page=@i&search=@search">@i</a>
                            </li>
                        }
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="page-link" href="/nha-tuyen-dung/dia-diem?page=@(Model.CurrentPage + 1)&search=@search">Sau</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

