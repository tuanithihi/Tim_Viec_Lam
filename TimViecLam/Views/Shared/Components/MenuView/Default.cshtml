@{
    var currentPath = Context.Request.Path.Value ?? "/";
    bool IsActive(string path) => currentPath.StartsWith(path, StringComparison.OrdinalIgnoreCase);
    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
    string displayName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Tài khoản";
    bool isSuperAdmin = User.IsInRole("SuperAdmin");
    bool isEmployer = User.IsInRole("Employer");
}

<header class="site-header">
    <div class="container-xl">
        <div class="site-navbar">
            <!-- Brand Logo -->
            <a href="/" class="navbar-brand" aria-label="TimViecLam - Trang chủ">
                <div class="brand-icon" aria-hidden="true">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <span class="brand-name">TimViecLam</span>
            </a>

            <!-- Quick Navigation Links (Desktop) -->
            <ul class="navbar-nav-links d-none d-lg-flex" role="list">
                <li role="listitem">
                    <a href="/viec-lam" class="nav-link @(IsActive("/viec-lam") ? "active" : "")"
                       aria-current="@(IsActive("/viec-lam") ? "page" : null)">Việc làm</a>
                </li>
                <li role="listitem">
                    <a href="/cong-ty" class="nav-link @(IsActive("/cong-ty") ? "active" : "")"
                       aria-current="@(IsActive("/cong-ty") ? "page" : null)">Công ty</a>
                </li>
                <li role="listitem">
                    <a href="/blog" class="nav-link @(IsActive("/blog") ? "active" : "")"
                       aria-current="@(IsActive("/blog") ? "page" : null)">Blog</a>
                </li>
                <li role="listitem">
                    <a href="/lien-he" class="nav-link @(IsActive("/lien-he") ? "active" : "")"
                       aria-current="@(IsActive("/lien-he") ? "page" : null)">Liên hệ</a>
                </li>
            </ul>

            <!-- Actions -->
            <div class="navbar-actions">
                <a href="/dang-tin" class="btn-post-job d-none d-md-inline-flex" id="btnPostJob">
                    <i class="bi bi-plus-circle" aria-hidden="true"></i>
                    <span>Đăng tuyển</span>
                </a>

                @if (!isLoggedIn)
                {
                    <a href="/dang-nhap" class="btn btn-neutral btn-sm d-none d-md-inline-flex" id="btnLogin">
                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                        Đăng nhập
                    </a>
                    <a href="/dang-ky" class="btn-brand btn btn-sm d-none d-md-inline-flex" id="btnRegister">
                        <i class="bi bi-person-plus" aria-hidden="true"></i>
                        Đăng ký
                    </a>
                }
                else
                {
                    <div class="dropdown d-none d-md-inline-block">
                        <button class="btn btn-neutral btn-sm dropdown-toggle d-flex align-items-center gap-1" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i>
                            <span class="text-truncate" style="max-width: 140px;">@displayName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm" aria-labelledby="userMenuDropdown">
                            @if (isSuperAdmin)
                            {
                                <li>
                                    <a class="dropdown-item text-danger font-medium" href="/Admin">
                                        <i class="bi bi-shield-lock me-2"></i>Khu quản trị Admin
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                            }
                            <li>
                                <a class="dropdown-item" href="/ho-so">
                                    <i class="bi bi-person-lines-fill me-2"></i>Hồ sơ cá nhân
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item" href="/doi-mat-khau">
                                    <i class="bi bi-key me-2"></i>Đổi mật khẩu
                                </a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="px-2 py-1">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                        <i class="bi bi-box-arrow-right me-1"></i>Đăng xuất
                                    </button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }

                <!-- Mobile toggle -->
                <button class="navbar-toggler-custom d-lg-none"
                        type="button"
                        id="mobileMenuToggle"
                        aria-expanded="false"
                        aria-controls="mobileMenu"
                        aria-label="Mở menu điều hướng">
                    <i class="bi bi-list fs-5" aria-hidden="true"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Menu Collapse -->
        <nav id="mobileMenu" class="d-lg-none" style="display:none;" aria-label="Menu điều hướng di động">
            <ul class="list-unstyled py-3 mb-0 border-top" style="gap:var(--space-1);" role="list">
                <li role="listitem">
                    <a href="/viec-lam" class="nav-link py-2 px-2" style="font-size:var(--text-sm);">
                        <i class="bi bi-briefcase me-2" aria-hidden="true"></i>Việc làm
                    </a>
                </li>
                <li role="listitem">
                    <a href="/cong-ty" class="nav-link py-2 px-2" style="font-size:var(--text-sm);">
                        <i class="bi bi-building me-2" aria-hidden="true"></i>Công ty
                    </a>
                </li>
                <li role="listitem">
                    <a href="/blog" class="nav-link py-2 px-2" style="font-size:var(--text-sm);">
                        <i class="bi bi-newspaper me-2" aria-hidden="true"></i>Blog
                    </a>
                </li>
                <li role="listitem">
                    <a href="/lien-he" class="nav-link py-2 px-2" style="font-size:var(--text-sm);">
                        <i class="bi bi-telephone me-2" aria-hidden="true"></i>Liên hệ
                    </a>
                </li>
                @if (!isLoggedIn)
                {
                    <li role="listitem" class="mt-2 pt-2 border-top d-flex gap-2 px-2">
                        <a href="/dang-nhap" class="btn btn-neutral btn-sm flex-fill" id="btnLoginMobile">Đăng nhập</a>
                        <a href="/dang-ky" class="btn-brand btn btn-sm flex-fill" id="btnRegisterMobile">Đăng ký</a>
                    </li>
                }
                else
                {
                    <li role="listitem" class="mt-2 pt-2 border-top px-2">
                        <div class="mb-2 font-medium">Xin chào, @displayName</div>
                        <div class="d-flex flex-column gap-1">
                            @if (isSuperAdmin)
                            {
                                <a href="/Admin" class="btn btn-outline-danger btn-sm text-start">
                                    <i class="bi bi-shield-lock me-1"></i>Khu quản trị Admin
                                </a>
                            }
                            <a href="/ho-so" class="btn btn-outline-secondary btn-sm text-start">
                                <i class="bi bi-person-lines-fill me-1"></i>Hồ sơ cá nhân
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="mt-1">
                                <button type="submit" class="btn btn-danger btn-sm w-100">Đăng xuất</button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </nav>
    </div>
</header>

<script>
    // Mobile menu toggle
    (function () {
        var btn = document.getElementById('mobileMenuToggle');
        var menu = document.getElementById('mobileMenu');
        if (btn && menu) {
            btn.addEventListener('click', function () {
                var expanded = btn.getAttribute('aria-expanded') === 'true';
                btn.setAttribute('aria-expanded', !expanded);
                menu.style.display = expanded ? 'none' : 'block';
            });
        }
    })();
</script>
