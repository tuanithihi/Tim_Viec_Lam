@{
    ViewData["Title"] = "Không tìm thấy trang (404)";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/pages/error.css" asp-append-version="true" />

<div class="error-page-container" role="main">
    <div class="error-card">
        <div class="error-code" aria-hidden="true">404</div>
        <h1 class="error-heading">Trang không tìm thấy</h1>
        <p class="error-description">
            Trang bạn đang tìm kiếm có thể đã bị xóa, đổi tên,
            hoặc chưa từng tồn tại. Vui lòng kiểm tra lại đường dẫn.
        </p>

        <div class="error-actions">
            <a href="/" class="btn-brand btn">
                <i class="bi bi-house me-1" aria-hidden="true"></i>Về trang chủ
            </a>
            <a href="/viec-lam" class="btn btn-neutral">
                <i class="bi bi-briefcase me-1" aria-hidden="true"></i>Xem việc làm
            </a>
        </div>
    </div>
</div>
