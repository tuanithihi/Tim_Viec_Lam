<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!-- SEO Meta Tags -->
    <title>@(ViewData["Title"] ?? "TimViecLam - Sàn Tìm Việc Làm Hàng Đầu Việt Nam")</title>
    <meta name="description" content="@(ViewData["Description"] ?? "TimViecLam - Kết nối ứng viên với nhà tuyển dụng uy tín. Tìm việc nhanh, lương cao, ổn định.")">
    <meta name="keywords" content="@(ViewData["Keywords"] ?? "tìm việc làm, tuyển dụng, việc làm, nhà tuyển dụng, ứng viên, timviecLam")">
    <meta name="author" content="TimViecLam">

    <!-- Canonical & Open Graph -->
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")">
    <meta property="og:site_name" content="TimViecLam">
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")">
    <meta property="og:title" content="@(ViewData["Title"] ?? "TimViecLam - Sàn Tìm Việc Làm")">
    <meta property="og:description" content="@(ViewData["Description"] ?? "Tìm việc nhanh chóng, ổn định, thu nhập cao tại TimViecLam.")">

    @await RenderSectionAsync("SeoHead", required: false)

    <!-- Vendor CSS: Bootstrap 5 + Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet"
          crossorigin="anonymous">

    <!-- Design System CSS -->
    <link href="~/css/variables.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/base.css" rel="stylesheet" asp-append-version="true">
    <link href="~/css/components.css" rel="stylesheet" asp-append-version="true">

    @await RenderSectionAsync("Styles", required: false)
</head>

<body style="display:flex; flex-direction:column; min-height:100vh;">

    <!-- Skip link truy cập nhanh nội dung (Accessibility) -->
    <a href="#main-content" class="skip-link">Chuyển đến nội dung chính</a>

    <!-- ── Site Header & Navigation ──────────────────────────── -->
    @await Component.InvokeAsync("MenuView")

    <!-- ── Global Toast Notifications ───────────────────────── -->
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="alert-toast-container" role="alert" aria-live="polite">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show shadow-sm border" role="alert"
                     style="border-radius:var(--radius-md);">
                    <i class="bi bi-check-circle-fill me-2 text-success" aria-hidden="true"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show shadow-sm border" role="alert"
                     style="border-radius:var(--radius-md);">
                    <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng thông báo"></button>
                </div>
            }
        </div>
    }

    <!-- ── Main Content Area ─────────────────────────────────── -->
    <main id="main-content" style="flex:1;">
        @RenderBody()
    </main>

    <!-- ── Site Footer ───────────────────────────────────────── -->
    <footer class="site-footer">
        <div class="container-xl footer-top">
            <div class="row gy-4">
                <!-- Col 1: Brand Info -->
                <div class="col-lg-4 col-md-12">
                    <a href="/" class="d-inline-flex align-items-center gap-2 mb-3 text-decoration-none">
                        <div class="brand-icon">
                            <i class="bi bi-briefcase-fill" aria-hidden="true"></i>
                        </div>
                        <span class="brand-name">TimViecLam</span>
                    </a>
                    <p class="small text-muted mb-3" style="line-height:1.6;">
                        Nền tảng kết nối ứng viên với nhà tuyển dụng uy tín. Tìm việc theo vị trí, địa điểm,
                        lương, ngành nghề - nhanh chóng, minh bạch và an toàn.
                    </p>
                    <div class="d-flex align-items-center gap-3 text-muted small">
                        <span><i class="bi bi-shield-check text-success me-1" aria-hidden="true"></i>Tin thật - Việc thật</span>
                        <span><i class="bi bi-headset me-1" aria-hidden="true"></i>Hỗ trợ 24/7</span>
                    </div>
                </div>

                <!-- Col 2: Job Categories -->
                <div class="col-lg-2 col-6">
                    <h5 class="footer-col-title">Ngành nghề</h5>
                    <ul class="footer-links-list">
                        <li><a href="/viec-lam?nganh=cong-nghe">Công nghệ thông tin</a></li>
                        <li><a href="/viec-lam?nganh=kinh-doanh">Kinh doanh / Sales</a></li>
                        <li><a href="/viec-lam?nganh=ke-toan">Kế toán / Tài chính</a></li>
                        <li><a href="/viec-lam?nganh=marketing">Marketing</a></li>
                        <li><a href="/viec-lam">Tất cả ngành nghề</a></li>
                    </ul>
                </div>

                <!-- Col 3: Guide & Policy -->
                <div class="col-lg-3 col-6">
                    <h5 class="footer-col-title">Hướng dẫn</h5>
                    <ul class="footer-links-list">
                        <li><a href="/Home/Privacy">Chính sách bảo mật</a></li>
                        <li><a href="/dang-tin">Đăng tin tuyển dụng</a></li>
                        <li><a href="/lien-he">Liên hệ & Hỗ trợ</a></li>
                        <li><a href="/Admin/Account/Login">Kênh Nhà tuyển dụng / Admin</a></li>
                    </ul>
                </div>

                <!-- Col 4: Contact -->
                <div class="col-lg-3 col-md-12">
                    <h5 class="footer-col-title">Liên hệ & Hỗ trợ</h5>
                    <p class="small text-muted mb-2">
                        <i class="bi bi-geo-alt me-2" aria-hidden="true"></i>Toàn quốc, Việt Nam
                    </p>
                    <p class="small text-muted mb-2">
                        <i class="bi bi-telephone me-2" aria-hidden="true"></i>Hotline: <strong>1900 8888</strong>
                    </p>
                    <p class="small text-muted mb-3">
                        <i class="bi bi-envelope me-2" aria-hidden="true"></i>
                        <a href="mailto:support@timviecLam.vn" class="text-decoration-none">support@timviecLam.vn</a>
                    </p>
                    <div class="d-flex gap-2">
                        <a href="#" class="btn btn-neutral btn-sm" aria-label="Facebook TimViecLam">
                            <i class="bi bi-facebook" aria-hidden="true"></i>
                        </a>
                        <a href="#" class="btn btn-neutral btn-sm" aria-label="YouTube TimViecLam">
                            <i class="bi bi-youtube" aria-hidden="true"></i>
                        </a>
                        <a href="#" class="btn btn-neutral btn-sm" aria-label="Zalo TimViecLam">
                            <i class="bi bi-chat-dots" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <div class="container-xl footer-bottom-content">
                <div>
                    &copy; @DateTime.Now.Year TimViecLam. Giữ toàn quyền bản quyền nội dung và thiết kế.
                </div>
                <div class="d-flex gap-3">
                    <a href="/Home/Privacy" class="text-muted text-decoration-none">Bảo mật</a>
                    <a href="/lien-he" class="text-muted text-decoration-none">Điều khoản</a>
                    <a href="/lien-he" class="text-muted text-decoration-none">Trợ giúp</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- ── Scripts ────────────────────────────────────────────── -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc4s9bIOgUxi8T/jzmJJx0sbLz0DG3R4fM5bnkRHK10"
            crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
