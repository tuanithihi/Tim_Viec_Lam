@model TimViecLam.Models.ViewModels.ErrorViewModel
@{
    ViewData["Title"] = "Đã xảy ra lỗi (500)";
    Layout = "_Layout";
}

<link rel="stylesheet" href="~/css/pages/error.css" asp-append-version="true" />

<div class="error-page-container" role="main">
    <div class="error-card">
        <div class="error-code" aria-hidden="true">500</div>
        <h1 class="error-heading">Đã xảy ra lỗi máy chủ</h1>
        <p class="error-description">
            Hệ thống đang gặp sự cố tạm thời khi xử lý yêu cầu của bạn.
            Đội ngũ kỹ thuật đã được thông báo để khắc phục sớm nhất.
        </p>

        @if (Model?.ShowRequestId == true)
        {
            <div class="p-2 mb-4 rounded text-muted small"
                 style="border: 1px dashed var(--border-color); background-color: var(--color-bg-muted);">
                Mã theo dõi lỗi: <code>@Model.RequestId</code>
            </div>
        }

        <div class="error-actions">
            <a href="/" class="btn-brand btn">
                <i class="bi bi-house me-1" aria-hidden="true"></i>Về trang chủ
            </a>
            <button onclick="window.location.reload()" class="btn btn-neutral" type="button">
                <i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Thử tải lại
            </button>
        </div>
    </div>
</div>
