@model TimViecLam.Models.ViewModels.CompanyProfileInputModel
@{
    ViewData["Title"] = "Hồ sơ công ty";
    var company = ViewBag.Company as TimViecLam.Models.ViewModels.CompanyProfileViewModel;
}

<div class="container-xl py-4">
    <!-- Breadcrumb / Header -->
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-xs">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/nha-tuyen-dung/trang-thai" class="text-decoration-none text-muted">Nhà tuyển dụng</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Hồ sơ công ty</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Hồ sơ Doanh nghiệp</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (company != null)
            {
                <span class="badge @(company.Status == "Approved" ? "bg-success" : company.Status == "Pending" ? "bg-warning text-dark" : "bg-danger") px-3 py-2">
                    Trạng thái: @(company.Status == "Approved" ? "Đã duyệt" : company.Status == "Pending" ? "Chờ duyệt" : company.Status == "Suspended" ? "Tạm khóa" : "Bị từ chối")
                </span>
            }
            <a href="/nha-tuyen-dung/dia-diem" class="btn btn-neutral btn-sm">
                <i class="bi bi-geo-alt me-1"></i>Địa điểm làm việc (@(company?.WorkplaceCount ?? 0))
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Cột trái: Quản lý Logo công ty -->
        <div class="col-12 col-lg-4">
            <div class="card border shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-image me-2 text-primary"></i>Logo công ty</h6>
                </div>
                <div class="card-body text-center p-4">
                    <div class="mb-3 position-relative d-inline-block">
                        <div id="logoPreviewContainer" class="rounded border p-2 bg-light d-flex align-items-center justify-content-center"
                             style="width: 140px; height: 140px; margin: 0 auto;">
                            @if (!string.IsNullOrEmpty(company?.Logo))
                            {
                                <img id="companyLogoImg" src="@company.Logo" alt="@company.Name" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                            }
                            else
                            {
                                <i id="logoPlaceholderIcon" class="bi bi-building fs-1 text-muted"></i>
                                <img id="companyLogoImg" src="" alt="Logo" class="d-none" style="max-width: 100%; max-height: 100%; object-fit: contain;" />
                            }
                        </div>
                    </div>

                    <div class="text-xs text-muted mb-3">
                        Định dạng: JPG, PNG, WebP, GIF, SVG (Tối đa 2MB).
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <label for="logoFileInput" class="btn btn-outline-primary btn-sm w-100 cursor-pointer mb-0">
                            <i class="bi bi-upload me-1"></i>Chọn và tải logo mới
                        </label>
                        <input type="file" id="logoFileInput" accept=".jpg,.jpeg,.png,.webp,.gif,.svg" class="d-none" />

                        <button type="button" id="btnDeleteLogo" class="btn btn-outline-danger btn-sm w-100 @(string.IsNullOrEmpty(company?.Logo) ? "d-none" : "")">
                            <i class="bi bi-trash me-1"></i>Xóa logo
                        </button>
                    </div>

                    <div id="logoUploadAlert" class="alert alert-danger text-xs p-2 mt-3 d-none"></div>
                </div>
            </div>

            <!-- Thống kê thông tin -->
            @if (company != null)
            {
                <div class="card border shadow-sm mt-4">
                    <div class="card-body p-3 small">
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Đường dẫn định danh:</span>
                            <code class="text-xs">@company.Slug</code>
                        </div>
                        <div class="d-flex justify-content-between py-1 border-bottom">
                            <span class="text-muted">Ngày tạo hồ sơ:</span>
                            <span>@company.CreatedAt.ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="d-flex justify-content-between py-1">
                            <span class="text-muted">Số địa điểm làm việc:</span>
                            <span class="fw-bold">@company.WorkplaceCount</span>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Cột phải: Form cập nhật thông tin -->
        <div class="col-12 col-lg-8">
            <div class="card border shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="mb-0 fw-bold text-dark"><i class="bi bi-pencil-square me-2 text-primary"></i>Thông tin chung của doanh nghiệp</h6>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Profile" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger text-sm mb-3"></div>

                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="Name" class="form-label small fw-semibold">Tên công ty <span class="text-danger">*</span></label>
                                <input asp-for="Name" class="form-control" placeholder="Ví dụ: Công ty Cổ phần Công nghệ ABC" />
                                <span asp-validation-for="Name" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="TaxCode" class="form-label small fw-semibold">Mã số thuế doanh nghiệp</label>
                                <input asp-for="TaxCode" class="form-control" placeholder="Ví dụ: 0102030405" />
                                <span asp-validation-for="TaxCode" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="CompanySize" class="form-label small fw-semibold">Quy mô công ty <span class="text-danger">*</span></label>
                                <select asp-for="CompanySize" class="form-select">
                                    <option value="Micro">Dưới 10 nhân viên (Micro)</option>
                                    <option value="Small">10 - 49 nhân viên (Small)</option>
                                    <option value="Medium">50 - 249 nhân viên (Medium)</option>
                                    <option value="Large">250 - 999 nhân viên (Large)</option>
                                    <option value="Enterprise">Trên 1000 nhân viên (Enterprise)</option>
                                </select>
                                <span asp-validation-for="CompanySize" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Email" class="form-label small fw-semibold">Email liên hệ tuyển dụng</label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="hr@company.com" />
                                <span asp-validation-for="Email" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12 col-md-6">
                                <label asp-for="Phone" class="form-label small fw-semibold">Số điện thoại liên hệ</label>
                                <input asp-for="Phone" class="form-control" placeholder="024 1234 5678" />
                                <span asp-validation-for="Phone" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Website" class="form-label small fw-semibold">Trang web công ty</label>
                                <input asp-for="Website" class="form-control" placeholder="https://company.com" />
                                <span asp-validation-for="Website" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Address" class="form-label small fw-semibold">Địa chỉ trụ sở chính</label>
                                <input asp-for="Address" class="form-control" placeholder="Tầng 5, Tòa nhà Landmark, 123 Đường ABC..." />
                                <span asp-validation-for="Address" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label small fw-semibold">Giới thiệu về doanh nghiệp</label>
                                <textarea asp-for="Description" class="form-control" rows="5" placeholder="Mô tả tầm nhìn, sứ mệnh, môi trường làm việc và văn hóa công ty..."></textarea>
                                <span asp-validation-for="Description" class="text-danger text-xs"></span>
                            </div>

                            <div class="col-12 text-end pt-2">
                                <button type="submit" class="btn btn-brand px-4">
                                    <i class="bi bi-save me-1"></i>Lưu thay đổi hồ sơ
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fileInput = document.getElementById('logoFileInput');
            const alertBox = document.getElementById('logoUploadAlert');
            const logoImg = document.getElementById('companyLogoImg');
            const placeholderIcon = document.getElementById('logoPlaceholderIcon');
            const btnDelete = document.getElementById('btnDeleteLogo');

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : '';

            // Tải logo qua AJAX
            fileInput.addEventListener('change', async function () {
                if (!this.files || this.files.length === 0) return;
                const file = this.files[0];

                alertBox.classList.add('d-none');
                alertBox.textContent = '';

                const formData = new FormData();
                formData.append('logoFile', file);

                try {
                    const response = await fetch('/nha-tuyen-dung/logo', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        },
                        body: formData
                    });

                    const data = await response.json();
                    if (data.success) {
                        logoImg.src = data.logoUrl;
                        logoImg.classList.remove('d-none');
                        if (placeholderIcon) placeholderIcon.classList.add('d-none');
                        btnDelete.classList.remove('d-none');
                    } else {
                        alertBox.textContent = data.message || 'Không thể tải logo.';
                        alertBox.classList.remove('d-none');
                    }
                } catch (err) {
                    alertBox.textContent = 'Lỗi kết nối khi tải file logo.';
                    alertBox.classList.remove('d-none');
                } finally {
                    fileInput.value = '';
                }
            });

            // Xóa logo
            btnDelete.addEventListener('click', async function () {
                if (!confirm('Bạn có chắc chắn muốn xóa logo công ty hiện tại?')) return;

                try {
                    const response = await fetch('/nha-tuyen-dung/xoa-logo', {
                        method: 'POST',
                        headers: {
                            'RequestVerificationToken': token
                        }
                    });

                    const data = await response.json();
                    if (data.success) {
                        logoImg.src = '';
                        logoImg.classList.add('d-none');
                        if (placeholderIcon) placeholderIcon.classList.remove('d-none');
                        btnDelete.classList.add('d-none');
                    } else {
                        alert(data.message || 'Không thể xóa logo.');
                    }
                } catch (err) {
                    alert('Lỗi kết nối khi xóa logo.');
                }
            });
        });
    </script>
}

