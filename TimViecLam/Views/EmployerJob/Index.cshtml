@model TimViecLam.Models.ViewModels.EmployerJobListViewModel
@{
    ViewData["Title"] = "Quản lý tin tuyển dụng";
    string currentStatus = Model.Filter.Status ?? "All";
}

<div class="container-xl py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 text-xs">
                    <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted">Trang chủ</a></li>
                    <li class="breadcrumb-item"><a href="/nha-tuyen-dung/ho-so" class="text-decoration-none text-muted">Nhà tuyển dụng</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Tin tuyển dụng</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold text-dark mb-0">Quản lý Tin Tuyển Dụng</h1>
        </div>
        <div>
            <a href="/nha-tuyen-dung/tin-tuyen-dung/them" class="btn btn-brand px-3 py-2 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i>Đăng tin mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <!-- Tab chuyển đổi trạng thái -->
    <div class="card border shadow-sm mb-4">
        <div class="card-header bg-white border-bottom p-0">
            <ul class="nav nav-tabs border-0 px-3 pt-2" style="gap: 4px;">
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == "All" ? "active fw-bold text-primary" : "text-muted")"
                       href="/nha-tuyen-dung/tin-tuyen-dung?Status=All">
                        Tất cả <span class="badge bg-secondary ms-1">@Model.StatusCounts.GetValueOrDefault("All", 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == "Published" ? "active fw-bold text-success" : "text-muted")"
                       href="/nha-tuyen-dung/tin-tuyen-dung?Status=Published">
                        Đang xuất bản <span class="badge bg-success ms-1">@Model.StatusCounts.GetValueOrDefault("Published", 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == "Pending" ? "active fw-bold text-warning" : "text-muted")"
                       href="/nha-tuyen-dung/tin-tuyen-dung?Status=Pending">
                        Chờ duyệt <span class="badge bg-warning text-dark ms-1">@Model.StatusCounts.GetValueOrDefault("Pending", 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == "Draft" ? "active fw-bold text-secondary" : "text-muted")"
                       href="/nha-tuyen-dung/tin-tuyen-dung?Status=Draft">
                        Bản nháp <span class="badge bg-secondary ms-1">@Model.StatusCounts.GetValueOrDefault("Draft", 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == "Rejected" ? "active fw-bold text-danger" : "text-muted")"
                       href="/nha-tuyen-dung/tin-tuyen-dung?Status=Rejected">
                        Bị từ chối <span class="badge bg-danger ms-1">@Model.StatusCounts.GetValueOrDefault("Rejected", 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == "Closed" ? "active fw-bold text-dark" : "text-muted")"
                       href="/nha-tuyen-dung/tin-tuyen-dung?Status=Closed">
                        Đã đóng <span class="badge bg-dark ms-1">@Model.StatusCounts.GetValueOrDefault("Closed", 0)</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(currentStatus == "Expired" ? "active fw-bold text-muted" : "text-muted")"
                       href="/nha-tuyen-dung/tin-tuyen-dung?Status=Expired">
                        Hết hạn <span class="badge bg-light text-dark border ms-1">@Model.StatusCounts.GetValueOrDefault("Expired", 0)</span>
                    </a>
                </li>
            </ul>
        </div>
        <div class="card-body p-3">
            <form method="get" action="/nha-tuyen-dung/tin-tuyen-dung" class="row g-2 align-items-center">
                <input type="hidden" name="Status" value="@currentStatus" />
                <div class="col-12 col-md-6 col-lg-5">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="Keyword" value="@Model.Filter.Keyword" class="form-control" placeholder="Tìm theo tiêu đề việc làm..." />
                        @if (!string.IsNullOrWhiteSpace(Model.Filter.Keyword))
                        {
                            <a href="/nha-tuyen-dung/tin-tuyen-dung?Status=@currentStatus" class="btn btn-outline-secondary" title="Xóa tìm kiếm">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>
                <div class="col-6 col-md-3 col-lg-3">
                    <button type="submit" class="btn btn-neutral btn-sm px-3">
                        <i class="bi bi-filter me-1"></i>Lọc
                    </button>
                </div>
                <div class="col-6 col-md-3 col-lg-4 text-end text-xs text-muted">
                    Hiển thị <strong>@Model.Jobs.Count</strong> / <strong>@Model.TotalItems</strong> tin
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách tin tuyển dụng -->
    <div class="card border shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-xs text-uppercase">
                    <tr>
                        <th style="min-width: 250px;">Tiêu đề việc làm</th>
                        <th>Ngành nghề / Hình thức</th>
                        <th>Địa điểm</th>
                        <th>Mức lương</th>
                        <th>Lượt xem / Đơn</th>
                        <th>Hạn nộp</th>
                        <th>Trạng thái</th>
                        <th class="text-end" style="min-width: 160px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody class="text-sm">
                    @if (Model.Jobs.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                                Không có tin tuyển dụng nào phù hợp với bộ lọc hiện tại.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var job in Model.Jobs)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold text-dark mb-1">
                                        <a href="/nha-tuyen-dung/tin-tuyen-dung/sua/@job.JobId" class="text-decoration-none text-dark hover-primary">
                                            @job.Title
                                        </a>
                                    </div>
                                    <div class="text-xs text-muted">
                                        Ngày đăng: @job.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                    @if (job.ApprovalStatus == "Rejected" && !string.IsNullOrEmpty(job.RejectReason))
                                    {
                                        <div class="alert alert-danger py-1 px-2 text-xs mt-1 mb-0">
                                            <i class="bi bi-info-circle me-1"></i>Lý do từ chối: @job.RejectReason
                                        </div>
                                    }
                                </td>
                                <td>
                                    <div>@job.CategoryName</div>
                                    <span class="badge bg-light text-dark border text-xs">@job.JobTypeName</span>
                                </td>
                                <td>
                                    <div class="text-truncate" style="max-width: 150px;" title="@job.WorkplaceName">
                                        <i class="bi bi-geo-alt me-1 text-primary"></i>@job.WorkplaceName
                                    </div>
                                    <span class="text-xs text-muted">@job.WorkMode</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-danger">@job.SalaryDisplay</span>
                                </td>
                                <td>
                                    <div class="text-xs"><i class="bi bi-eye me-1"></i>@job.ViewCount lượt xem</div>
                                    <div class="text-xs fw-semibold text-primary"><i class="bi bi-file-earmark-person me-1"></i>@job.ApplicationCount hồ sơ</div>
                                </td>
                                <td>
                                    <div class="@(job.IsExpired ? "text-danger fw-bold" : "")">
                                        @job.ExpiresAt.ToString("dd/MM/yyyy")
                                    </div>
                                    @if (job.IsExpired)
                                    {
                                        <span class="badge bg-danger text-xs">Hết hạn</span>
                                    }
                                </td>
                                <td>
                                    @switch (job.ApprovalStatus)
                                    {
                                        case "Published":
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Xuất bản</span>
                                            break;
                                        case "Pending":
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Chờ duyệt</span>
                                            break;
                                        case "Draft":
                                            <span class="badge bg-secondary"><i class="bi bi-pencil me-1"></i>Bản nháp</span>
                                            break;
                                        case "Rejected":
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>
                                            break;
                                        case "Closed":
                                            <span class="badge bg-dark"><i class="bi bi-lock me-1"></i>Đã đóng</span>
                                            break;
                                        case "Expired":
                                            <span class="badge bg-light text-dark border"><i class="bi bi-calendar-x me-1"></i>Hết hạn</span>
                                            break;
                                        default:
                                            <span class="badge bg-secondary">@job.ApprovalStatus</span>
                                            break;
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a href="/nha-tuyen-dung/tin-tuyen-dung/sua/@job.JobId" class="btn btn-neutral" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        @if (job.ApprovalStatus == "Draft")
                                        {
                                            <form method="post" action="/nha-tuyen-dung/tin-tuyen-dung/gui-duyet/@job.JobId" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn gửi tin này để phê duyệt?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-neutral text-primary" title="Gửi duyệt">
                                                    <i class="bi bi-send"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (job.ApprovalStatus == "Published")
                                        {
                                            <form method="post" action="/nha-tuyen-dung/tin-tuyen-dung/dong-tin/@job.JobId" class="d-inline" onsubmit="return confirm('Đóng tin tuyển dụng này? Ứng viên sẽ không thể nộp đơn nữa.');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-neutral text-warning" title="Đóng tin">
                                                    <i class="bi bi-lock"></i>
                                                </button>
                                            </form>
                                        }

                                        @if (job.ApprovalStatus == "Closed" || job.ApprovalStatus == "Expired")
                                        {
                                            <form method="post" action="/nha-tuyen-dung/tin-tuyen-dung/mo-lai/@job.JobId" class="d-inline" onsubmit="return confirm('Mở lại tin tuyển dụng này?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-neutral text-success" title="Mở lại tin">
                                                    <i class="bi bi-unlock"></i>
                                                </button>
                                            </form>
                                        }

                                        <form method="post" action="/nha-tuyen-dung/tin-tuyen-dung/nhan-ban/@job.JobId" class="d-inline" title="Nhân bản thành bản nháp mới">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-neutral" title="Nhân bản tin">
                                                <i class="bi bi-copy"></i>
                                            </button>
                                        </form>

                                        <form method="post" action="/nha-tuyen-dung/tin-tuyen-dung/xoa/@job.JobId" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tin này không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-neutral text-danger" title="Xóa tin">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white border-top py-3 d-flex justify-content-between align-items-center">
                <span class="text-xs text-muted">
                    Trang <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong>
                </span>
                <nav aria-label="Phân trang tin tuyển dụng">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                            <a class="page-link" href="/nha-tuyen-dung/tin-tuyen-dung?Status=@currentStatus&Keyword=@Model.Filter.Keyword&PageIndex=@(Model.PageIndex - 1)">
                                Trước
                            </a>
                        </li>
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                <a class="page-link" href="/nha-tuyen-dung/tin-tuyen-dung?Status=@currentStatus&Keyword=@Model.Filter.Keyword&PageIndex=@p">
                                    @p
                                </a>
                            </li>
                        }
                        <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="/nha-tuyen-dung/tin-tuyen-dung?Status=@currentStatus&Keyword=@Model.Filter.Keyword&PageIndex=@(Model.PageIndex + 1)">
                                Sau
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

