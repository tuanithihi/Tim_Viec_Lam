@model TimViecLam.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h2 class="text-center mb-4 font-bold" style="color: var(--brand-primary);">Đổi mật khẩu</h2>

                    <form asp-action="ChangePassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label font-medium"></label>
                            <input asp-for="OldPassword" class="form-control" placeholder="Nhập mật khẩu hiện tại" autocomplete="current-password" />
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label font-medium"></label>
                            <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 8 ký tự, có chữ và số" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label font-medium"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <a href="/ho-so" class="btn btn-outline-secondary">Quay lại</a>
                            <button type="submit" class="btn btn-brand px-4 font-medium">Cập nhật mật khẩu</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

