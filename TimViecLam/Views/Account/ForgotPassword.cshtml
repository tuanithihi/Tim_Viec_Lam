@model TimViecLam.Models.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h2 class="text-center mb-3 font-bold" style="color: var(--brand-primary);">Quên mật khẩu</h2>
                    <p class="text-center text-muted mb-4 small">Nhập email đăng ký của bạn. Chúng tôi sẽ gửi liên kết hướng dẫn đặt lại mật khẩu an toàn.</p>

                    @if (ViewBag.Message != null)
                    {
                        <div class="alert alert-info" role="alert">
                            @ViewBag.Message
                        </div>
                    }

                    <form asp-action="ForgotPassword" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label font-medium"></label>
                            <input asp-for="Email" class="form-control" placeholder="example@domain.com" autocomplete="email" autofocus />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-brand w-100 py-2 font-medium">Gửi yêu cầu</button>
                    </form>

                    <div class="text-center mt-4">
                        <a href="/dang-nhap" class="text-decoration-none small" style="color: var(--brand-primary-hover);">
                            <i class="bi bi-arrow-left me-1"></i>Quay lại trang Đăng nhập
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
