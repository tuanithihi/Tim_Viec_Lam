@model TimViecLam.Models.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu mới";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4 p-md-5">
                    <h2 class="text-center mb-3 font-bold" style="color: var(--brand-primary);">Đặt lại mật khẩu</h2>
                    <p class="text-center text-muted mb-4 small">Tạo mật khẩu mới cho tài khoản: <strong>@Model.Email</strong></p>

                    <form asp-action="ResetPassword" method="post" novalidate>
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="Token" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label font-medium"></label>
                            <input asp-for="NewPassword" class="form-control" placeholder="Tối thiểu 8 ký tự, có chữ và số" autocomplete="new-password" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label font-medium"></label>
                            <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-brand w-100 py-2 font-medium">Đặt lại mật khẩu</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

